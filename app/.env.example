# Copy to .env.local and fill in. Never commit real values.

# Supabase (local CLI: `npx supabase status` prints these; hosted: Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key for the AI-assisted template rewrite. Server-side only.
ANTHROPIC_API_KEY=
