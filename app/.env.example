# Copy to .env.local and fill in. Never commit real values (.env.local is git-ignored).
#
# Local development: start the stack (`npx supabase start`), then run
# `npm run env:local` to fill the three Supabase values below from
# `npx supabase status -o env`.

# Supabase project URL (hosted: Project Settings > API; local: API_URL).
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key. Safe for the browser; row-level security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key. SERVER-ONLY: bypasses row-level security, so it must never be
# exposed to the browser or given a NEXT_PUBLIC_ prefix. Used to create workspaces.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key for the AI-assisted template rewrite. Server-side only.
ANTHROPIC_API_KEY=
