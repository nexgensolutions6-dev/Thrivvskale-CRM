# Cloud PostgreSQL connection string (Neon, Supabase, Railway, RDS, Azure, ...).
# "postgres://" and "postgresql://" are both accepted. Cloud providers usually need sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Long random string used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Comma separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Timezone used for follow-up times in Excel import / export
APP_TIMEZONE=Asia/Kolkata

# First owner account, created by `python -m scripts.seed`
SEED_OWNER_NAME=Ravi Kumar
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=change-me-now
